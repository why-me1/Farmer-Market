# Ignore system files
.DS_Store
Thumbs.db

# Ignore local environment settings
.env
*.env

# Ignore VS Code settings
.vscode/
*.code-workspace

# Ignore PHPStorm or other IDE config
.idea/

# Ignore vendor and dependencies
vendor/

# Ignore node modules
node_modules/

# Ignore database files and backups
*.sql
database_backup/
backup/
*.bak

# Ignore uploaded user files
uploads/
images/uploads/
assets/uploads/

# Ignore local server logs
*.log
logs/
error_log

# Ignore config files containing credentials
config.php
db.php

# Additional recommended ignores
# Local env and secret variants
.env.local
.env.*.local
*.key
*.pem
.ssh/

# Logs and caches
npm-debug.log*
yarn-error.log*
.cache/
.sass-cache/
coverage/
phpunit.result.cache

# Temporary/runtime files
tmp/
temp/
sessions/
uploads/tmp/
public/uploads/tmp/

# Security keys and certs
*.p12
*.crt
*.csr

# Editor/project files
*.sublime-workspace
